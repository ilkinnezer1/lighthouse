MODE=local
BASE_DOMAIN=localhost

# Required only when MODE=server. Used by Traefik to register Let's Encrypt certs.
ACME_EMAIL=

POSTGRES_USER=lighthouse
POSTGRES_PASSWORD=lighthouse_dev_pw
POSTGRES_DB=lighthouse_dev
POSTGRES_PORT=5432

DATABASE_URL=postgresql://lighthouse:lighthouse_dev_pw@localhost:5432/lighthouse_dev?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# BuildKit, used only by the `railpack` build strategy. BUILDKIT_PORT publishes
# the buildkitd container on loopback; the worker needs BUILDKIT_HOST in its own
# .env (lighthouse-worker/.env) so the railpack CLI can reach it.
BUILDKIT_PORT=1234
BUILDKIT_HOST=tcp://127.0.0.1:1234

MASTER_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

JWT_SECRET=replace-with-openssl-rand-hex-64

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme

ALLOW_PUBLIC_SIGNUP=true

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Atlassian OAuth 2.0 (3LO) app — powers Jira issue titles on branch labels.
# Scopes: read:jira-work read:jira-user read:me offline_access.
# Callback: ${API_URL}/integrations/atlassian/callback. Optional; unset disables it.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=

API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ---- production (docker-compose.prod.yml only) ----
# Must not collide with the deploy URL shape <env>.<project>.<user>.${BASE_DOMAIN}.
LIGHTHOUSE_HOST=lighthouse.example.com
# OAuth callbacks are registered against ${PUBLIC_URL}/api.
PUBLIC_URL=https://lighthouse.example.com

MINIO_ROOT_USER=lighthouse
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=snapshots

# Mounted at this same path inside the worker — see docker-compose.prod.yml.
LIGHTHOUSE_DATA_DIR=/opt/lighthouse/data
